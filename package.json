{
  "name": "balint-dc-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun --no-env-file run scripts/build.ts",
    "build:all": "bun --no-env-file run scripts/build.ts all",
    "release:prepare": "bun --no-env-file run scripts/release.ts",
    "release:publish": "bun --no-env-file run scripts/publish.ts",
    "format": "bun run --bun oxfmt .",
    "format:check": "bun run --bun oxfmt --check .",
    "lint": "bun run --bun oxlint --max-warnings 0 .",
    "lint:fix": "bun run --bun oxlint --fix --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
